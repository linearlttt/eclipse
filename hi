Services.RunService.RenderStepped:Connect(function()
    if not Rigs.RootPart then return end
    Variables.FightTool = Variables.Backpack:FindFirstChild("Fight") or Variables.Character:FindFirstChild("Fight")
    
    if States.Movement then
        if Configs.MovementType == "Blink" then
            Rigs.RootPart.CFrame += Rigs.Humanoid.MoveDirection / 8 * Configs.BlinkSpeed
        elseif Configs.MovementType == "Sprint" then
            if Variables.Character:FindFirstChild("Sprint") then
                Rigs.RootPart.CFrame += Rigs.Humanoid.MoveDirection / 8 * Configs.BlinkSpeed
            end
        end
    end

    if States.AutoFarm and Configs.FarmType == "Respect" then
        if Configs.PlayerType == "Left [ALT]" then
            Rigs.RootPart.AssemblyAngularVelocity = Vector3.zero
            Rigs.RootPart.AssemblyLinearVelocity = Vector3.zero
        elseif Configs.PlayerType == "Right" then
            Rigs.RootPart.CFrame = CFrame.new(-83, 5, -4)
        end
    end

    if States.WeaveGlide then
        if Variables.Character:FindFirstChild("Knocked").Value == true then return end
        local MoveDirection = Rigs.Humanoid.MoveDirection
        local BodyPosition = Rigs.RootPart:FindFirstChildOfClass("BodyPosition")

        if MoveDirection.Magnitude > 0.1 then
            if BodyPosition and BodyPosition.Name ~= "HeavyAttack" then
                BodyPosition.Position = Rigs.RootPart.Position + (MoveDirection.Unit * Configs.GlideStrength)
                BodyPosition.MaxForce = Vector3.new(30000, 30000, 30000)
                BodyPosition.D = 15
            end
        end
    end

    if States.AutoEquip and not Variables.Character:FindFirstChildOfClass("Tool") then
        if Variables.FightTool and Variables.FightTool.Parent == Variables.Backpack then
            Variables.FightTool.Parent = Variables.Character
        end
    end

    if States.AutoWeave and Rigs.Humanoid.Health > 0 then
        if tick() - Configs.WeaveTime >= Configs.WeaveDelay then
            Configs.WeaveTime = tick()
            local Weave = GetRemote()
        
            pcall(function()
                Weave:FireServer("Weave", nil, true)
            end)
        end
    end

    if States.AutoFarm and Rigs.Humanoid.Health > 0 then
        Rigs.Humanoid:ChangeState(Enum.HumanoidStateType.Running)
        Rigs.Humanoid.PlatformStand = false
    end

    if States.LockOn then
        if Variables.Character:FindFirstChild("Knocked").Value == true then return end
        if Variables.FightTool and Variables.FightTool.Parent == Variables.Character then
            local ClosestTargetObj = GetClosestPlayer()
            if ClosestTargetObj and ClosestTargetObj.Character then
                local TargetRootPart = ClosestTargetObj.Character:FindFirstChild("HumanoidRootPart")
                local TargetHumanoid = ClosestTargetObj.Character:FindFirstChildOfClass("Humanoid")
                if TargetRootPart and TargetHumanoid and TargetHumanoid.Health > 0 then
                    local LockDistanceValue = (Rigs.RootPart.Position - TargetRootPart.Position).Magnitude
                    if LockDistanceValue > Configs.LockonDistance then return end
                    local DirectionVector = (TargetRootPart.Position - Rigs.RootPart.Position)
                    DirectionVector = Vector3.new(DirectionVector.X, 0, DirectionVector.Z)
                    if DirectionVector.Magnitude > 0 then
                        Rigs.RootPart.CFrame = Rigs.RootPart.CFrame:Lerp(CFrame.new(Rigs.RootPart.Position, Rigs.RootPart.Position + DirectionVector.Unit), 0.5)
                    end
                end
            end
        end
    end

    if States.HitAura and tick() - Configs.AuraTime >= Configs.AuraDelay then
        Configs.AuraTime = tick()
        Attack()
    end

    if tick() - Configs.HitboxTime > 1 then
        Configs.HitboxTime = tick()

        for _, PlayerObj in ipairs(Services.Players:GetPlayers()) do
            if PlayerObj ~= Variables.LocalPlayer then
                SetHitbox(PlayerObj, States.Hitbox)
            end
        end
    end

	if States.AntiFling then
		for _, player in ipairs(Services.Players:GetPlayers()) do
            if player ~= Variables.LocalPlayer and player.Character then
                local Char = player.Character
                local RootPart = Char:FindFirstChild("HumanoidRootPart")
                
                if RootPart then
                    --[[for _, part in ipairs(Char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end]]
                    
                    local Velocity = RootPart.Velocity
                    if Velocity.Magnitude > 50 then
                        RootPart.Velocity = Velocity.Unit * 50
                    end
    
                    if sethiddenproperty then
                        sethiddenproperty(RootPart, "NetworkIsSleeping", true)
                    end
                end
            end
        end
	end

    if States.AntiStun then
        if Variables.Character:FindFirstChild("WeaveStun") then Variables.Character:FindFirstChild("WeaveStun"):Destroy() end
    end

    if States.HitSpeed then
        local AttackAnims = Variables.Character.Core.Animations.Styles[Variables.Class.Value].M1s
        local DownHit =  Variables.Character.Core.Animations:FindFirstChild("Down_Hits")
      
        for _, anim in ipairs(AttackAnims:GetChildren()) do
            HitAnimNames[anim.Name] = true
        end

        for _, AnimTrack in pairs(Rigs.Humanoid:GetPlayingAnimationTracks()) do
            local animName = AnimTrack.Name

            if HitAnimNames[animName] then
                AnimTrack:AdjustSpeed(Configs.PunchSpeed)
            end
        end
    end

    if Variables.LocalPlayer:FindFirstChild("Loaded") then
        Variables.LocalPlayer.Loaded.Value = not States.GodMode
    end
end)

