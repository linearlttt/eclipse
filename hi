function Attack(args1)
    if not (Rigs.Humanoid and Rigs.RootPart) then return end

    local AttackRemoteEvent = GetRemote()
    local TargetPlayerObj = args1

    -- Fix: If PlayerSort == "Target", get the first valid target from the Playerlist.
    if not TargetPlayerObj and Configs.PlayerSort == "Target" and #Playerlist > 0 then
        TargetPlayerObj = Playerlist[1]
    end
    if not TargetPlayerObj then
        TargetPlayerObj = GetClosestPlayer()
    end

    if AttackRemoteEvent and TargetPlayerObj and TargetPlayerObj.Character then
        local TargetRoot = TargetPlayerObj.Character:FindFirstChild("HumanoidRootPart")
        if TargetRoot then
            local Distance = (Rigs.RootPart.Position - TargetRoot.Position).Magnitude
            if Distance > Configs.Distance then return end
            local HitLimb = TargetPlayerObj.Character:FindFirstChild("LeftLowerLeg") or TargetRoot
            local NextHand = (Configs.CurrentHand == "RightHand") and "LeftHand" or "RightHand"
            pcall(function()
                AttackRemoteEvent:FireServer("Attack", {
                    Point = TargetRoot.Position,
                    Combo = 5,
                    Class = Variables.Class.Value,
                    IsKnockdown = false,
                    Character = TargetPlayerObj.Character,
                    Hit = HitLimb,
                    Limb = Configs.CurrentHand,
                    Classs = "{BF174C4F-D904-4B0C-8C31-6DE105CC786E}",
                    Result = nil
                }, false)
                AttackRemoteEvent:FireServer("Swing", {Limb = Configs.CurrentHand})
                task.wait()
                AttackRemoteEvent:FireServer("Swing", {Limb = NextHand})
            end)
            Configs.CurrentHand = NextHand
        end
    end
end

function ToggleAutoFarm(args1)
	if not Configs.FarmType == "Server" then return end
    States.AutoFarm = args1
    States.AutoEquip = args1
	States.HitAura = args1
	
    if not args1 then return end

    local SkipList = {}
    local PlayerIdCache

    if not Variables.AirPart then
        Variables.AirPart = Instance.new("Part", Workspace)
        Variables.AirPart.Anchored = true
        Variables.AirPart.Size = Vector3.new(6, 1, 6)
        Variables.AirPart.Transparency = 1
        Variables.AirPart.CanCollide = false
        Variables.AirPart.Name = "AutoFarmHover"
    end

    task.spawn(function()
        while States.AutoFarm and Configs.FarmType == "Server" and task.wait() do
			Services.UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			Services.UserInputService.MouseIconEnabled = args1
			
            UpdatePlayerList(function(PlayerObj)
                if SkipList[PlayerObj.UserId] then return false end
                if PlayerObj:FindFirstChild("Loaded").Value == false then return false end
                local HumanoidObj = PlayerObj.Character and PlayerObj.Character:FindFirstChildOfClass("Humanoid")
                if not (HumanoidObj and HumanoidObj.Health > 0) then return false end
                return true
            end)

            if #Playerlist == 0 then
                Configs.Target = nil
                Configs.PlayerIndex = 1
                task.wait(1)
                continue
            end

            local PlayerIdx = Configs.PlayerIndex
            local AttemptCount = 0
            local TargetPlayerObj = nil
            while not TargetPlayerObj and AttemptCount < #Playerlist do
                TargetPlayerObj = Playerlist[PlayerIdx]
                if not TargetPlayerObj or not TargetPlayerObj.Character or not TargetPlayerObj.Character:FindFirstChild("HumanoidRootPart") then
                    TargetPlayerObj = nil
                elseif SkipList[TargetPlayerObj.UserId] then
                    TargetPlayerObj = nil
                end
                if not TargetPlayerObj then
                    PlayerIdx = (PlayerIdx % #Playerlist) + 1
                end
                AttemptCount = AttemptCount + 1
            end

            Configs.PlayerIndex = PlayerIdx
            if TargetPlayerObj and TargetPlayerObj ~= Variables.LocalPlayer then
                local Success, ErrorMsg = pcall(function()
                    if PlayerIdCache ~= TargetPlayerObj.UserId then
                        PlayerIdCache = TargetPlayerObj.UserId
                    end
                    Variables.AirPart.CFrame = Rigs.RootPart.CFrame * CFrame.new(0, -3.5, 0)
                    Teleport(TargetPlayerObj, Configs.FarmDuration)
                end)
                if not Success then
                    SkipList[TargetPlayerObj.UserId] = true
                    Configs.PlayerIndex = (Configs.PlayerIndex % #Playerlist) + 1
                end
            else
                Configs.PlayerIndex = (Configs.PlayerIndex % #Playerlist) + 1
            end
        end

        if Variables.AirPart then pcall(function() Variables.AirPart:Destroy() end) end
    end)
end

local Connections = {}
function DisableThrowables(args1)
    States.Interact = args1

    local Interaction = workspace:FindFirstChild("Map")
        and workspace.Map:FindFirstChild("Interaction")

    if not Interaction then
        return
    end

    local function Taken(model, value)
        if model:IsA("Model") then
            model:SetAttribute("Taken", value)
        end
    end

    for _, connection in ipairs(Connections) do
        connection:Disconnect()
    end
    table.clear(Connections)

    for _, folder in ipairs(Interaction:GetChildren()) do
        if folder:IsA("Folder") then

            for _, model in ipairs(folder:GetChildren()) do
                Taken(model, args1)
            end

            if args1 then
                table.insert(Connections,
                    folder.ChildAdded:Connect(function(model)
                        Taken(model, true)
                    end)
                )
            end
        end
    end
end

function SetHitbox(args1, arg2)
    if not args1 or not args1.Character then
        return
    end

    local CharObj = args1.Character
    local Humanoid = CharObj:FindFirstChildOfClass("Humanoid")
    local RootPart = CharObj:FindFirstChild("HumanoidRootPart")
    if not Humanoid or not RootPart then
        return
    end

    local KnockedObj = CharObj:FindFirstChild("Knocked")
    local IsKnocked = KnockedObj and KnockedObj.Value == true

    if arg2 and Humanoid.Health > 0 and not (States.GroundCheck and IsKnocked) then
        RootPart.Size = Vector3.new(Configs.HitboxSize, Configs.HitboxSize, Configs.HitboxSize)
    else
        RootPart.Size = Vector3.new(2, 5, 1)
    end

    RootPart.Transparency = 1
    RootPart.CanCollide = false
    RootPart.CanTouch = false
    --RootPart.Massless = true

    local highlight = RootPart:FindFirstChild("EclipseHitboxHighlight")
    if not highlight then
        highlight = Instance.new("SelectionBox")
        highlight.Name = "EclipseHitboxHighlight"
        highlight.Adornee = RootPart
        highlight.LineThickness = 0.05
        highlight.SurfaceTransparency = 1
        highlight.Parent = RootPart
    end

    highlight.Color3 = _G.UIColor
    highlight.Visible = arg2 and States.ShowHitbox
end

