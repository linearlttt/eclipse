function GetRemote()
    local CoreObject = Variables.Character:FindFirstChild("Core")
    local CommunicateObject = CoreObject and CoreObject:FindFirstChild("Communicate")
    if not CommunicateObject then return nil end
    for _, Child in ipairs(CommunicateObject:GetChildren()) do
        if Child:IsA("RemoteEvent") then
            return Child
        end
    end
    return nil
end

function GetPlayer(args1)
    args1 = string.lower(tostring(args1))

    for _, Player in ipairs(Services.Players:GetPlayers()) do
        if Player == Variables.LocalPlayer then
            continue
        end

        local Username = string.lower(Player.Name)
        local DisplayName = string.lower(Player.DisplayName)

        if Username == args1 then
            return Player
        end

        if DisplayName == args1 then
            return Player
        end
    end

    for _, Player in ipairs(Services.Players:GetPlayers()) do
        if Player == Variables.LocalPlayer then
            continue
        end

        local Username = string.lower(Player.Name)
        local DisplayName = string.lower(Player.DisplayName)

        if string.find(Username, args1, 1, true)
        or string.find(DisplayName, args1, 1, true) then
            return Player
        end
    end
end

function UpdatePlayerList(args1)
    Playerlist = {}
    for _, PlayerObj in ipairs(Services.Players:GetPlayers()) do
        local Valid = true
        if PlayerObj == Variables.LocalPlayer then Valid = false end
        if Blacklisted[PlayerObj.UserId] then Valid = false end
        if not (PlayerObj.Character and PlayerObj.Character:FindFirstChild("HumanoidRootPart") and PlayerObj.Character:FindFirstChildOfClass("Humanoid")) then Valid = false end
        if Valid and PlayerObj.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then Valid = false end

        if Valid and args1 then
            Valid = args1(PlayerObj)
        end
        if Valid then
            table.insert(Playerlist, PlayerObj)
        end
    end

    if Configs.PlayerSort == "Target" then
        local TargetInput = Configs.TargetName and string.lower(Configs.TargetName) or nil
        local FilteredTable = {}
        if TargetInput and TargetInput ~= "" then
            for _, PlayerObj in ipairs(Playerlist) do
                local Username = string.lower(PlayerObj.Name)
                if Username == TargetInput then
                    table.insert(FilteredTable, PlayerObj)
                end
            end

            if #FilteredTable == 0 then
                for _, PlayerObj in ipairs(Playerlist) do
                    local DisplayName = string.lower(PlayerObj.DisplayName)
                    if DisplayName == TargetInput then
                        table.insert(FilteredTable, PlayerObj)
                    end
                end
            end
            -- If still nothing, fall back to substring match
            if #FilteredTable == 0 then
                for _, PlayerObj in ipairs(Playerlist) do
                    local Username = string.lower(PlayerObj.Name)
                    local DisplayName = string.lower(PlayerObj.DisplayName)
                    if string.find(Username, TargetInput, 1, true) or string.find(DisplayName, TargetInput, 1, true) then
                        table.insert(FilteredTable, PlayerObj)
                    end
                end
            end
        end
        Playerlist = FilteredTable
    elseif Configs.PlayerSort == "Low Health" then
        local FilteredTable = {}
        for _, PlayerObj in ipairs(Playerlist) do
            local HumObj = PlayerObj.Character and PlayerObj.Character:FindFirstChildOfClass("Humanoid")
            if HumObj and HumObj.Health < Configs.HealthAmount then
                table.insert(FilteredTable, PlayerObj)
            end
        end
        Playerlist = FilteredTable
    elseif Configs.PlayerSort == "Random" then
        for i = #Playerlist, 2, -1 do
            local j = math.random(i)
            Playerlist[i], Playerlist[j] = Playerlist[j], Playerlist[i]
        end
    end

    if Configs.PlayerIndex > #Playerlist then
        Configs.PlayerIndex = 1
    end
end

function Teleport(args1, args2)
    local TargetRootPart = args1.Character:FindFirstChild("HumanoidRootPart")
    local TargetHumanoid = args1.Character:FindFirstChildOfClass("Humanoid")
    if not (Rigs.RootPart and TargetRootPart) then return end

    local StartTime = tick()
    local DurationValue = args2 or Configs.FarmDuration

    repeat
		Rigs.RootPart.CFrame = (TargetRootPart.CFrame + Vector3.new(0, 3, 0) + (TargetRootPart.Velocity * Configs.Prediction))
        task.wait()
    until not States.AutoFarm or not TargetHumanoid or TargetHumanoid.Health <= 0 or tick() - StartTime > DurationValue
end

function WallCheckFunction(args1, args2)
    local RayParams = RaycastParams.new()
    RayParams.FilterDescendantsInstances = {Variables.Character}
    RayParams.FilterType = Enum.RaycastFilterType.Blacklist
    local RayResult = Services.Workspace:Raycast(args1, args2 - args1, RayParams)
    if RayResult and RayResult.Instance then
        local HitModel = RayResult.Instance:FindFirstAncestorOfClass("Model")
        if HitModel and HitModel:FindFirstChild("HumanoidRootPart") then
            return true
        else
            return false
        end
    end
    return true
end

function GetClosestPlayer()
    if not Rigs.RootPart then return nil end
    local ClosestPlayerObj = nil
    local ClosestDistance = math.huge
    for _, PlayerObj in ipairs(Services.Players:GetPlayers()) do
        if
            PlayerObj ~= Variables.LocalPlayer
            and PlayerObj.Character
            and PlayerObj.Character:FindFirstChild("HumanoidRootPart")
            and PlayerObj.Character:FindFirstChildOfClass("Humanoid")
            and PlayerObj.Character:FindFirstChildOfClass("Humanoid").Health > 0
        then
            local PlayerRootPart = PlayerObj.Character:FindFirstChild("HumanoidRootPart")
            local Distance = (Rigs.RootPart.Position - PlayerRootPart.Position).Magnitude
            if Distance < ClosestDistance then
                if WallCheckFunction(Rigs.RootPart.Position, PlayerRootPart.Position) then
                    ClosestDistance = Distance
                    ClosestPlayerObj = PlayerObj
                end
            end
        end
    end
    return ClosestPlayerObj
end

