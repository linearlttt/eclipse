local Meta = SafeCall(Game)
local NameCallFunction = Meta.__namecall
local NewIndexFunction = Meta.__newindex

for _, v in pairs(getgc(true)) do
    if type(v) == "table" then
        local Success, IndexInstance = pcall(rawget, v, "indexInstance")
        if Success and type(IndexInstance) == "table" and IndexInstance[1] == "kick" then
            pcall(function()
                setreadonly(v, false)
                rawset(v, "tvk", {"kick", function() return task.wait(9e9) end})
                setreadonly(v, true)
            end)
        end

    end
end

pcall(function()
    setreadonly(Meta, false)
    if not Meta then
        warn("Failed to get metatable!")
        return
    end

    Meta.__namecall = function(SelfObj, ...)
        if checkcaller() then return NameCallFunction(SelfObj, ...) end
        local Method = getnamecallmethod()
        return NameCallFunction(SelfObj, ...)
    end

    Meta.__newindex = function(SelfObj, KeyVal, ValueVal)
        if checkcaller() then
            return NewIndexFunction(SelfObj, KeyVal, ValueVal)
        end
        if States.PlayerLockOn and Variables.Character and SelfObj:IsDescendantOf(Variables.Character) then
            if SelfObj.Name == "HumanoidRootPart" or SelfObj.Name == "UpperTorso" or SelfObj.Name == "LowerTorso" then
                if KeyVal == "CFrame" or KeyVal == "Position" then
                    local ClosestTargetObj = GetClosestPlayer()
                    if ClosestTargetObj and ClosestTargetObj.Character and ClosestTargetObj.Character:FindFirstChild("HumanoidRootPart") then
                        local TargetRootPart = ClosestTargetObj.Character:FindFirstChild("HumanoidRootPart")
                        local DistToTarget = (Rigs.RootPart.Position - TargetRootPart.Position).Magnitude
                        if DistToTarget <= Configs.LockonDistance then
                            return
                        end
                    end
                end
            end
        end
        return NewIndexFunction(SelfObj, KeyVal, ValueVal)
    end
end)

